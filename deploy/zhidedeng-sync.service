# 由 zhidedeng-sync.timer 定时触发，把飞书收集表同步进投稿队列。
#
# 为什么用 oneshot + timer 而不是长驻进程：同步是「拉一次、算一张计划、提交一个
# 批次」，跑完就该退出。长驻进程反而要自己处理间隔、重叠执行和崩溃重启。
#
# 安装（服务器上）：
#   sudo cp deploy/zhidedeng-sync.service deploy/zhidedeng-sync.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zhidedeng-sync.timer
#
# 前置条件（缺一个这条 timer 就是在空转）：
#   1. /etc/zhidedeng/zhidedeng.env 里有 FEISHU_BASE_TOKEN、FEISHU_TABLE_ID、
#      LARKSUITE_CLI_CONFIG_DIR、SYNC_TOKEN、SITE_URL；
#   2. 服务器装了 lark-cli 并且只读权限够读那张表；
#   3. 仓库已经 pnpm install，并且 Node ≥ 22（脚本用原生类型剥离直接跑 .ts）。
#
# 路径按实际部署改：下面按仓库放在 /opt/zhidedeng、跑服务的用户叫 zhidedeng 写。
#
# 排查：`journalctl -u zhidedeng-sync.service -n 100`。同步脚本对任何非 2xx 都
# 会中止并打印原因，默认不会半途写坏数据——特别是表格为空时它会拒绝执行，
# 免得一次读空把在架站点全规划成下架。
[Unit]
Description=zhidedeng Feishu table sync
Documentation=file:/opt/zhidedeng/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zhidedeng
Group=zhidedeng
WorkingDirectory=/opt/zhidedeng
EnvironmentFile=/etc/zhidedeng/zhidedeng.env
# --dry-run 之外的模式会真的提交批次；默认待人工审核，所以这条 timer 只负责
# 「把新内容放进审核台」，不会自作主张上线。
# 直接调 node，不经过 pnpm：pnpm 会往 HOME 下的 store/cache 写东西，而下面
# ProtectHome=true 正好把 HOME 封掉，用它只会得到一个难以理解的权限错误。
# 这条脚本只读仓库 + 发 HTTP，不需要写工作目录。
ExecStart=/usr/bin/env node --experimental-strip-types scripts/sync-feishu.ts
# 单次运行的上限：正常情况下几秒到几十秒；卡住时别把下次触发一起堵住。
TimeoutStartSec=900
#运维约定：**下架要在飞书表格里做，不要只点审核台。**表格里还留着记录时，
#下一轮同步会把该站点按正常投稿重新上架（既有设计：群友填错后重新提交就该恢复）。
UMask=0077
StateDirectory=zhidedeng
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# 仓库本身只读；StateDirectory 里的目录可写，留给将来需要落盘的情形。
ReadWritePaths=/var/lib/zhidedeng
PrivateTmp=true