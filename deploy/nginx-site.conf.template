# nginx 站点模板。替换占位符后放到 /etc/nginx/sites-available/ 并启用，同时删掉发行版自带的 default 站点
# （两个 default_server 会冲突）：
#   __SERVER_NAME__  域名
#   __TLS_CERT__     证书路径
#   __TLS_KEY__      私钥路径
#   __APP_PORT__     服务端口，与环境文件里的 PORT 一致
#
# 管理接口默认只允许本机访问。要从外部用网页管理台，在 location /api/admin/ 里
# 的 deny all 之前追加 allow <你的出口 IP 或网段>，然后 nginx -s reload。
#
# Node 只监听 127.0.0.1。这里用 $remote_addr 覆盖 X-Forwarded-For，客户端伪造的值不会传进去，
# 服务端限流按它识别 IP。只监听 IPv4：服务器不用 IPv6，也避开 limit_req 按单个地址计数被 /64 绕过。

# key 为空的请求不计入对应的限速区。读写分开计数。
map $request_method $zhidedeng_read_key {
  default "";
  GET     $binary_remote_addr;
  HEAD    $binary_remote_addr;
}
map $request_method $zhidedeng_write_key {
  default "";
  POST    $binary_remote_addr;
  PUT     $binary_remote_addr;
  PATCH   $binary_remote_addr;
  DELETE  $binary_remote_addr;
}
limit_req_zone $zhidedeng_read_key zone=zhidedeng_api_read:10m rate=30r/s;
limit_req_zone $zhidedeng_write_key zone=zhidedeng_api_write:10m rate=2r/s;

# 兜底：Host 不是本站的请求直接断开。444 是 nginx 的「不响应直接关连接」。
server {
  listen 80 default_server;
  server_name _;
  return 444;
}
server {
  listen 443 ssl default_server;
  server_name _;
  ssl_certificate __TLS_CERT__;
  ssl_certificate_key __TLS_KEY__;
  return 444;
}

server {
  listen 80;
  server_name __SERVER_NAME__;
  return 301 https://__SERVER_NAME__$request_uri;
}

server {
  listen 443 ssl http2;
  server_name __SERVER_NAME__;

  ssl_certificate __TLS_CERT__;
  ssl_certificate_key __TLS_KEY__;

  # 投稿正文上限对应的请求体。
  client_max_body_size 1m;

  # 下面的 location 都不写 add_header，否则这些响应头不会被继承。
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  # 管理接口（含导入）。默认只放行服务器本机 127.0.0.1，其余来源返回 403（deny all 的默认状态码，不是 404）。
  #
  # 要走网页管理台又在服务器上开 SSH 隧道嫌麻烦时，在下面 allow 里加自己的出口 IP
  # 或办公网段（例如 allow 203.0.113.7; 或 allow 10.8.0.0/16;），再跑 nginx -s reload。
  # 用 IP 白名单而不是密码：管理接口本身已有 SYNC_TOKEN 校验，白名单是第二道；
  # 万一密钥泄漏，攻击者还得在这个网段里。
  #
  # 注意是 allow 在前 deny 在后：nginx 从上到下匹配，命中即停。
  # 加了 allow 之后，管理台页面本身（前端路由）也只在白名单网段能拿到数据。
  #
  # 这里必须用**正则** location，不能写 `location /api/admin/`：
  # 那是前缀匹配，`/api/admin-X`、`/api/adminx` 这类路径会落到下面无白名单的
  # `location /api/`，而 proxy_pass 不带 URI 时原 URI 原样转发，Hono 的路由树
  # 仍能把 `/api/admin/submissions` 匹配上（`-X` 只是多出来的路径段）。
  # 结果就是白名单被绕开、只剩 SYNC_TOKEN 一道门——和上面「第二道」的意图相反。
  # 正则里 `/api/admin(/|$)` 覆盖了后缀带斜杠和恰好等于 `/api/admin` 两种形态。
  location ~ ^/api/admin(/|$) {
    # 应用侧 import / submissions/batch 的上限是 8 MiB（server/src/app.ts 的
    # IMPORT_BODY_BYTES），而 server 级写的是 1 MiB——不覆盖的话 nginx 先回 413，
    # 请求根本到不了应用，运维只会看到一句「请求太大」。留一倍余量承载 multipart 头部。
    client_max_body_size 16m;
    # 只允许本机时保留这一行即可。
    allow 127.0.0.1;
    # 需要从外部访问时在下面这行之前追加 allow 条目。
    deny all;
    proxy_pass http://127.0.0.1:__APP_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # 首页一次会并发十几个 API 请求，读请求的 burst 给足，防的是持续抓取。
  location /api/ {
    limit_req zone=zhidedeng_api_read burst=60 nodelay;
    limit_req zone=zhidedeng_api_write burst=20 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:__APP_PORT__;
  }

  location / {
    proxy_pass http://127.0.0.1:__APP_PORT__;
  }
}
