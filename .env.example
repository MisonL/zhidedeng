# 复制成 .env 或服务器上的 /etc/zhidedeng/zhidedeng.env 后填写。不要提交真实值。

# --- 服务运行 ---
NODE_ENV=production
PORT=8787
# 生产环境必填。systemd 的 StateDirectory 会创建 /var/lib/zhidedeng（0700），放在它下面。
DB_PATH=/var/lib/zhidedeng/app.db
# 管理接口（导入、审核投稿、隐藏评论、禁用账号）的 Bearer 密钥。留空或不足 32 位时这些接口一律拒绝。
# 生成：openssl rand -hex 32
SYNC_TOKEN=
# Agent 凭证签发邀请码，可选，多个值用逗号分隔。留空时仅按注册时长或通过的投稿准入。
INVITE_CODES=
# 前端目录，默认是 server.mjs 同目录下的 web/，一般不用设。
# WEB_ROOT=

# --- 备份（deploy/backup-sqlite.sh）---
BACKUP_DIR=/var/lib/zhidedeng/backups
BACKUP_KEEP=14

# --- 飞书同步（scripts/sync-feishu.ts），在服务器本机运行 ---
# lark-cli 的配置目录。必填，不回落到默认的 ~/.lark-cli。
# LARKSUITE_CLI_CONFIG_DIR=
# FEISHU_BASE_TOKEN=
# FEISHU_TABLE_ID=
# SITE_URL=http://127.0.0.1:8787
# SYNC_TOKEN 与上面相同

# --- 部署（deploy/deploy.sh），在本地设置 ---
# DEPLOY_HOST=user@your-server
# DEPLOY_PATH=/opt/zhidedeng
# DEPLOY_SERVICE=zhidedeng
# APP_PORT=8787

# 本站对外是否走 HTTPS。设 1 时会话 cookie 会带 Secure 标记。
# 纯本机 http 试用保持 0，否则浏览器会丢弃 cookie、表现为登录后又变回未登录。
TLS_ENABLED=1
# 反代网段（IP 或 CIDR，逗号分隔）。不配则所有请求来源都会记成网关地址，
# 按 IP 的限流会退化成全站共用一个桶。容器部署用下面这条查网段：
#   docker network inspect <项目名>_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=
