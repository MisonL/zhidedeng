{
  "name": "@zhidedeng/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --outfile=dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@zhidedeng/shared": "workspace:*",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
